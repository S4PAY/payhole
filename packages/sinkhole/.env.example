# ---- Resolver (dnsmasq) ----
# Address and port dnsmasq binds inside the container. Keep 0.0.0.0:53 and map ports with Docker.
DNS_LISTEN=0.0.0.0
DNS_PORT=53
# Upstream resolvers, comma separated, as ip or ip#port.
UPSTREAM_DNS=1.1.1.1,9.9.9.9
# dnsmasq cache size in entries (0 disables the cache).
DNS_CACHE_SIZE=10000
# Unprivileged user dnsmasq switches to after binding; the image creates "dnsmasq". Leave empty outside the image.
DNSMASQ_USER=dnsmasq
# Path of the dnsmasq binary; only needed when it is not on PATH.
DNSMASQ_BINARY=dnsmasq

# ---- Admin API ----
ADMIN_LISTEN=0.0.0.0
ADMIN_PORT=8053
# Bearer token for every /api route and the admin page. Required. Generate one: openssl rand -hex 32
ADMIN_TOKEN=

# ---- Storage ----
# State, the dnsmasq configuration and the libp2p key live here; mount a volume.
DATA_DIR=/data

# ---- Blocklist sources ----
# Optional URL serving the same JSON the extension pushes; pulled every EXTENSION_PULL_MINUTES.
EXTENSION_BLOCKLIST_URL=
EXTENSION_PULL_MINUTES=15
# Optional file with one hostname per line (hosts-file lines and # comments are accepted), read at startup.
MANUAL_BLOCKLIST_FILE=
# Distinct swarm reporters needed before a domain is blocked, and how long a flag counts.
FLAG_THRESHOLD=5
FLAG_TTL_DAYS=30
# How often this node re-announces its own explicit flags so late joiners converge.
FLAG_REANNOUNCE_MINUTES=30

# ---- Swarm (libp2p gossipsub) ----
# Set to 0 to run as a plain local blocker without joining the swarm.
SWARM_ENABLED=1
# Listen multiaddrs, comma separated.
SWARM_LISTEN=/ip4/0.0.0.0/tcp/4001
# Bootstrap peers, comma separated multiaddrs including the peer id, e.g. /dns4/node.example/tcp/4001/p2p/12D3KooW...
SWARM_BOOTSTRAP=
# Set to 1 to discover peers on the local network with mDNS.
SWARM_MDNS=0

# ---- Membership (BurnVault unlock tier) ----
# Minimum BurnVault.tierOf(address) a reporter must hold. 0 disables the on-chain check (open swarm).
MIN_TIER=1
# RPC and chain used for the tier lookup; defaults to the official Robinhood Chain RPC and chain 4663.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# BurnVault address. Defaults to the SDK deployment record when it lists one; required otherwise when MIN_TIER > 0.
BURN_VAULT_ADDRESS=
# Operator wallet private key (hex). Signs the membership proof at startup and every announcement this node publishes.
NODE_OPERATOR_KEY=
# Alternative for keeping the wallet key off the host: the operator address plus a proof signed offline
# (see `node dist/main.js peer-id`). Without NODE_OPERATOR_KEY the node verifies and consumes swarm data but
# cannot sign announcements, so it does not publish.
NODE_OPERATOR_ADDRESS=
NODE_PROOF_JSON=

# ---- Directory probe ----
# Development only: allow probing endpoints on loopback and private networks. Never enable on a public node.
PROBE_ALLOW_PRIVATE=0
