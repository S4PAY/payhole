{
  "name": "@payhole/sinkhole",
  "version": "0.0.0",
  "private": true,
  "description": "PayHole Sinkhole: a dnsmasq-based DNS blocker fed by the browser extension and by a libp2p swarm that shares drainer and scam domain flags and an x402 endpoint directory.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/bootstrap": "12.0.32",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/gossipsub": "17.1.1",
    "@libp2p/identify": "4.1.14",
    "@libp2p/interface": "3.3.0",
    "@libp2p/mdns": "12.0.32",
    "@libp2p/peer-id": "6.0.15",
    "@libp2p/tcp": "11.0.28",
    "@payhole/sdk": "workspace:*",
    "libp2p": "3.3.11",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}
