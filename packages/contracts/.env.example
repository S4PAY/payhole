# Official Robinhood Chain RPC. The only endpoint deploy scripts will broadcast through.
RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com
# Archive endpoint for anvil forks and read-only queries. Never used for broadcasts.
ARCHIVE_RPC_URL_4663=https://rpc-robinhood.blockmachine.io
# Dedicated deployer EOA. Signs deployments only. Fund it with just enough ETH for the next deploy.
DEPLOYER_PRIVATE_KEY=
# Protocol owner: the Safe multisig on chain 4663. Every contract is constructed with this owner.
SAFE_ADDRESS=
# Initial verifier key for CreatorRegistry (the signing address of packages/verifier).
VERIFIER_ADDRESS=
# Port for the local anvil fork used by scripts/fork-test.sh.
ANVIL_PORT=8546
