# Address of the BudgetAccount the session key was issued on.
PAYHOLE_BUDGET_ACCOUNT=
# Where the CLI stores the session key (default ~/.payhole/session-key.json).
PAYHOLE_KEY_FILE=
# Private key override for the CLI; leave empty to use the key file.
PAYHOLE_SESSION_KEY=
# RPC endpoint; defaults to the official Robinhood Chain RPC.
PAYHOLE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
