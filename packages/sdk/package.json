{
  "name": "@payhole/sdk",
  "version": "0.0.0",
  "description": "PayHole client SDK: x402 payments from a session key against a BudgetAccount, plus a CLI.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "payhole": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @payhole/contracts build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "sync-abi": "node scripts/sync-abi.mjs"
  },
  "dependencies": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}
