{
  "name": "@payhole/sdk",
  "version": "0.2.0",
  "description": "PayHole client SDK: x402 payments from a session key against a BudgetAccount, plus a CLI.",
  "keywords": [
    "x402",
    "usdg",
    "robinhood-chain",
    "payments",
    "eip-3009",
    "payhole"
  ],
  "homepage": "https://payhole.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/S4PAY/payhole.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/S4PAY/payhole/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "payhole": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @payhole/contracts build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "sync-abi": "node scripts/sync-abi.mjs"
  },
  "dependencies": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}
