# Verifier signing key. Its address must be the registry's current verifier (set by the Safe).
VERIFIER_PRIVATE_KEY=
# CreatorRegistry address from packages/contracts/deployments/4663.json.
REGISTRY_ADDRESS=
# RPC used to read claim nonces; defaults to the official Robinhood Chain RPC.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# Attestation lifetime in seconds.
ATTESTATION_TTL_SECONDS=3600
# Requests per minute per client IP.
RATE_LIMIT_PER_MINUTE=10
# Set to 1 behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
# Optional comma-separated DNS servers for the TXT lookup, e.g. 1.1.1.1,8.8.8.8.
DNS_SERVERS=
HOST=0.0.0.0
PORT=8787
